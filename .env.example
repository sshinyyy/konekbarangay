NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-me
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=resident-supporting-documents
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Optional integration-test database; use a disposable database ending in _test.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/konekbarangay_test
QR_SIGNING_KEY_ID=qr-2026-01
QR_SIGNING_SECRET=replace-with-43-character-base64url-secret
# Optional JSON map of retained key IDs to base64url secrets for QR verification.
QR_SIGNING_PREVIOUS_KEYS={}

# Local QA seeding only. Keep disabled outside isolated development environments.
ALLOW_TEST_USER_SEED=false
QA_RESIDENT_PASSWORD=
QA_STAFF_PASSWORD=